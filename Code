/* CSS Code */



.container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.youtube{
    padding: 15px 35px;
    color: white;
    background-color: #FF0000;
    border: none;
    border-radius: 2cm;
    font-size: 18px;
    font-weight: bold;
    cursor:pointer;
    box-shadow: 11px 11px 20px rgba(0, 0, 0, 0.23);
    transition: all 0.3s ease;
    

}
.youtube:hover {
    background-color: white;
    color: red;
    transform: scale(1.2);
}



